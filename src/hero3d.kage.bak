/* ============================================================ the 3D hero
   Built the way Kage is built, with the salon's own shopfront.

   The lesson from Kage is not the temple, it is the exposure. Almost the whole
   frame is near-black; a handful of emissive surfaces are allowed to run past
   1.0; and a bloom chain reading a half-float buffer turns those into light.
   That is what makes it read as a photographed night rather than a lit render.
   An earlier pass modelled the same building but lit it evenly and put a lamp
   on the pavement — the fault was never the geometry, it was that nothing was
   dark.

   So: the storefront is real geometry, mostly silhouette. The windows, the
   fascia and the lamp globes are the only bright things in the scene. The
   ground is nearly black and returns a little of them. The wordmark stands
   close to the lens, rim-lit rather than washed. Fireflies drift across the
   lower band and scatter away from the cursor. */

(function () {
'use strict';

const host = document.getElementById('hero3d');
if (!host) return;

const REDUCE = matchMedia('(prefers-reduced-motion: reduce)').matches;
const COARSE = matchMedia('(hover: none)').matches;
if (REDUCE || !window.THREE) { host.classList.add('is-static'); return; }

let renderer;
try {
  renderer = new THREE.WebGLRenderer({ antialias: false, alpha: false, powerPreference: 'high-performance' });
} catch (e) { host.classList.add('is-static'); return; }

/* Linear out: the composite at the end of the chain does the tone map and the
   gamma encode, exactly as Kage does. Encoding here too would apply the curve
   twice and wash the blacks — which is most of what "cartoonish" means. */
renderer.outputEncoding = THREE.LinearEncoding;
renderer.toneMapping = THREE.NoToneMapping;
renderer.autoClear = false;
host.appendChild(renderer.domElement);

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x03050a);
scene.fog = new THREE.FogExp2(0x05070e, 0.030);

const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 300);
const CAM_BASE = new THREE.Vector3(0, 2.2, 30);
const LOOK = new THREE.Vector3(0, 6.8, 0);

/* Anything above 1 survives the bright pass and becomes bloom; anything below
   it merely lights the scene. That threshold is the whole trick. */
const hdr = (r, g, b) => new THREE.Color().setRGB(r, g, b);

/* ------------------------------------------------------------- lighting
   Deliberately almost nothing: two weak fills so the dark surfaces are not
   pure black, and one cool rim to cut the wordmark off the fog. Every actual
   highlight in this frame comes from an emissive surface, not a lamp. */
scene.add(new THREE.HemisphereLight(0x16223c, 0x020306, 0.30));
const rim = new THREE.DirectionalLight(0x7d9ad6, 0.42);
rim.position.set(-14, 10, 26);
scene.add(rim);
/* No lamp on the pavement. A point light out here is what produced the bright
   pool in front of the shop, and in a frame that is meant to be almost all
   black it immediately became the subject. The pilasters going to silhouette
   is the correct outcome, not a loss. */

/* ---------------------------------------------------------- environment
   A night street painted into a gradient and run through PMREM. Glass and
   polished metal are defined entirely by what they reflect; with nothing to
   reflect, glazing renders as flat card and brass as grey. This is what makes
   the shopfront read as wet, glossy and real rather than as blocked massing. */
{
  const c = document.createElement('canvas');
  c.width = 64; c.height = 256;
  const x = c.getContext('2d');
  const g = x.createLinearGradient(0, 0, 0, 256);
  g.addColorStop(0.00, '#02030a');
  g.addColorStop(0.40, '#0a1024');
  g.addColorStop(0.62, '#26243c');
  g.addColorStop(0.78, '#7c5233');
  g.addColorStop(0.90, '#c4854a');
  g.addColorStop(1.00, '#140d08');
  x.fillStyle = g; x.fillRect(0, 0, 64, 256);
  [[0.18, 0.72], [0.82, 0.72]].forEach(pt => {
    const rg = x.createRadialGradient(pt[0]*64, pt[1]*256, 0, pt[0]*64, pt[1]*256, 22);
    rg.addColorStop(0, 'rgba(255,206,140,.9)');
    rg.addColorStop(1, 'rgba(255,206,140,0)');
    x.fillStyle = rg; x.fillRect(0, 0, 64, 256);
  });
  const pm = new THREE.PMREMGenerator(renderer);
  pm.compileEquirectangularShader();
  const t = new THREE.CanvasTexture(c);
  t.mapping = THREE.EquirectangularReflectionMapping;
  t.encoding = THREE.sRGBEncoding;
  t.needsUpdate = true;
  scene.environment = pm.fromEquirectangular(t).texture;
  t.dispose(); pm.dispose();
}

/* ------------------------------------------------------------ materials */
const M = {
  render:   new THREE.MeshStandardMaterial({ color: 0x16171c, roughness: 0.58, metalness: 0.22, envMapIntensity: 0.9 }),
  frame:    new THREE.MeshStandardMaterial({ color: 0x0a0b0f, roughness: 0.20, metalness: 0.92, envMapIntensity: 1.6 }),
  timber:   new THREE.MeshStandardMaterial({ color: 0x2a1d14, roughness: 0.42, metalness: 0.30, envMapIntensity: 1.1 }),
  stone:    new THREE.MeshStandardMaterial({ color: 0x0a0b10, roughness: 0.22, metalness: 0.45, envMapIntensity: 1.2 }),
  /* the glazing itself: a dark mirror over the lit rooms */
  glass:    new THREE.MeshStandardMaterial({ color: 0x121a28, roughness: 0.04, metalness: 1.0,
              transparent: true, opacity: 0.15, envMapIntensity: 2.6,
              blending: THREE.AdditiveBlending, depthWrite: false }),
  glowWarm: new THREE.MeshBasicMaterial({ color: hdr(1.88, 1.02, 0.80) }),   /* the rooms    */
  glowBox:  new THREE.MeshBasicMaterial({ color: hdr(2.60, 2.30, 1.95) }),   /* the fascia   */
  glowLamp: new THREE.MeshBasicMaterial({ color: hdr(4.20, 2.40, 1.05) }),   /* lamp globes  */
  glowBand: new THREE.MeshBasicMaterial({ color: hdr(1.15, 0.78, 0.72) })    /* boutique band*/
};

const BOX = new THREE.BoxGeometry(1, 1, 1);
const put = (mat, x, y, z, w, h, d) => {
  const m = new THREE.Mesh(BOX, mat);
  m.position.set(x, y, z); m.scale.set(w, h, d);
  scene.add(m); return m;
};

/* ------------------------------------------------------- the storefront
   Read off exterior.jpg: three storeys, a wide centre bay flanked by two
   narrow ones, fluted timber pilasters on the mullion lines, render piers at
   the edges, the illuminated fascia across the ground floor. */
const W = 13.0, FLOOR = 3.9, TOP = FLOOR * 3 + 1.2;
const BAYS = [[-6.5, -2.3], [-1.7, 1.7], [2.3, 6.5]];

for (let f = 0; f < 3; f++) {
  const y0 = 0.35 + f * FLOOR, y1 = y0 + FLOOR - 0.85;
  BAYS.forEach(b => {
    const w = b[1] - b[0], cx = (b[0] + b[1]) / 2, h = y1 - y0, cy = (y0 + y1) / 2;
    put(M.glowWarm, cx, cy, -0.5, w - 0.30, h - 0.24, 0.06);   /* the lit room */
    put(M.glass,    cx, cy,  0.10, w - 0.02, h - 0.02, 0.02);  /* the glazing  */
    put(M.frame, b[0], cy, 0, 0.16, h, 0.22);
    put(M.frame, b[1], cy, 0, 0.16, h, 0.22);
    put(M.frame, cx, y0, 0, w, 0.14, 0.22);
    put(M.frame, cx, y1, 0, w, 0.14, 0.22);
    /* transoms. Without them each bay is one pale slab and the building reads
       as blocked-in massing rather than glazing. */
    [-0.30, 0.02, 0.34].forEach(t => put(M.frame, cx, cy + h * t, 0, w, 0.075, 0.18));
    /* a vertical mullion splitting the wide centre bay */
    if (w > 3) put(M.frame, cx, cy, 0, 0.11, h, 0.20);
  });
  if (f < 2) put(M.render, 0, y1 + 0.45, 0.06, W, 0.86, 0.30);
}

[-2.0, 2.0].forEach(x => {
  put(M.timber, x, TOP / 2, 0.20, 0.62, TOP, 0.34);
  for (let i = -3; i <= 3; i++) put(M.frame, x + i * 0.085, TOP / 2, 0.375, 0.022, TOP, 0.02);
});
[-1, 1].forEach(sx => put(M.render, sx * (W / 2 + 0.75), TOP / 2, -0.1, 1.5, TOP, 1.1));
put(M.render, 0, TOP + 0.35, -0.1, W + 3.0, 0.70, 1.2);

/* the illuminated fascia — the brightest thing in the frame */
put(M.render, 0, FLOOR + 0.30, 0.30, W - 0.6, 1.16, 0.30);
const boxFace = put(M.glowBox, 0, FLOOR + 0.30, 0.47, W - 1.1, 0.94, 0.02);
(function () {
  const c = document.createElement('canvas');
  c.width = 1024; c.height = 168;
  const x = c.getContext('2d');
  x.fillStyle = '#ffffff'; x.fillRect(0, 0, c.width, c.height);
  x.fillStyle = '#1a1206';
  x.textAlign = 'center'; x.textBaseline = 'middle';
  x.font = '500 76px "Cormorant Garamond", Georgia, serif';
  x.letterSpacing = '14px';
  x.fillText('INFINITY', c.width / 2, 66);
  x.font = '400 24px "Cormorant Garamond", Georgia, serif';
  x.letterSpacing = '20px';
  x.fillText('SALON', c.width / 2, 122);
  const t = new THREE.CanvasTexture(c);
  t.encoding = THREE.sRGBEncoding;
  boxFace.material = new THREE.MeshBasicMaterial({ map: t, color: hdr(2.4, 2.15, 1.85) });
})();
put(M.glowBand, 0, FLOOR * 2 + 0.30, 0.28, W - 1.2, 0.72, 0.10);

/* the recessed entrance — a dark void behind the glass line */
put(M.frame, 0, 1.5, -1.2, 3.3, 3.0, 0.10);
[-1, 1].forEach(sx => put(M.render, sx * 1.85, 1.5, -0.5, 0.55, 3.0, 1.5));

/* two lamp posts; their globes are among the few bright things allowed */
[-8.6, 8.6].forEach(x => {
  put(M.frame, x, 2.6, 5.0, 0.16, 5.2, 0.16);
  const g = new THREE.Mesh(new THREE.SphereGeometry(0.34, 14, 10), M.glowLamp);
  g.position.set(x, 5.35, 5.0); scene.add(g);
});
[-4.4, 4.4].forEach(x => put(M.stone, x, 0.42, 3.4, 1.15, 0.84, 1.15));

/* --------------------------------------------------------------- ground
   Near-black and slightly polished, so it returns the emissive accents as
   long soft streaks and nothing else. No lamp on the pavement. */
const ground = new THREE.Mesh(
  new THREE.PlaneGeometry(220, 220),
  new THREE.MeshStandardMaterial({ color: 0x05060b, roughness: 0.16, metalness: 0.70, envMapIntensity: 0.75 })
);
ground.rotation.x = -Math.PI / 2;
scene.add(ground);

/* cheap wet reflections: the bright pieces mirrored under the kerb */
const mirrorOf = (col, x, y, z, w, h, op) => {
  const m = new THREE.Mesh(BOX, new THREE.MeshBasicMaterial({
    color: col, transparent: true, opacity: op, depthWrite: false
  }));
  m.position.set(x, -y, z); m.scale.set(w, h, 0.02); scene.add(m);
};
mirrorOf(M.glowBox.color,  0, FLOOR + 0.30, 0.47, W - 1.1, 0.94, 0.16);
mirrorOf(M.glowBand.color, 0, FLOOR * 2 + 0.30, 0.28, W - 1.2, 0.72, 0.10);
BAYS.forEach(b => mirrorOf(M.glowWarm.color, (b[0] + b[1]) / 2, 2.2, -0.5, b[1] - b[0] - 0.3, 3.0, 0.10));

/* --------------------------------------------------------- the wordmark */
function wordmark(text, px, weight, tracking) {
  const c = document.createElement('canvas');
  let x = c.getContext('2d');
  const font = weight + ' ' + px + 'px "Cormorant Garamond", Georgia, serif';
  x.font = font; x.letterSpacing = tracking;
  c.width = Math.min(2048, Math.ceil(x.measureText(text).width) + 80);
  c.height = Math.round(px * 1.6);
  x = c.getContext('2d');
  x.font = font; x.letterSpacing = tracking;
  x.textAlign = 'center'; x.textBaseline = 'middle';
  x.fillStyle = '#ffffff';
  x.fillText(text, c.width / 2, c.height / 2);
  return c;
}

function extrude(text, px, weight, tracking, height, depth, slices, face, side) {
  const g = new THREE.Group();
  const cvs = wordmark(text, px, weight, tracking);
  const tex = new THREE.CanvasTexture(cvs);
  tex.encoding = THREE.sRGBEncoding;
  tex.anisotropy = Math.min(8, renderer.capabilities.getMaxAnisotropy());
  const w = height * (cvs.width / cvs.height);
  const geo = new THREE.PlaneGeometry(w, height);
  for (let i = slices - 1; i >= 0; i--) {
    const isFace = i === 0;
    const m = new THREE.Mesh(geo, new THREE.MeshStandardMaterial({
      map: tex, transparent: true, alphaTest: 0.45,
      color: isFace ? face : side,
      roughness: isFace ? 0.24 : 0.34,
      metalness: isFace ? 0.75 : 0.95,
      /* a whisper of self-light keeps the face off pure black against the fog
         without letting it cross the bloom threshold */
      emissive: new THREE.Color(isFace ? 0x0b1226 : 0x000000)
    }));
    m.position.z = -(i / (slices - 1)) * depth;
    g.add(m);
  }
  return g;
}

const big = extrude('INFINITY', 190, '500', '10px', 1.70, 0.34, 20, 0x2b3c60, 0xd2a45c);
big.position.set(0, 2.32, 24.0);
scene.add(big);
const small = extrude('HAIR AND BEAUTY SALON', 92, '400', '26px', 0.30, 0.11, 10, 0xc79a52, 0x634a24);
small.position.set(0, 1.38, 24.2);
scene.add(small);

/* ----------------------------------------------------------- fireflies
   Confined to the lower band, where they add depth against dark pavement
   instead of competing with the shopfront. The cursor pushes and swirls them
   in world space, so the disturbance belongs to the scene rather than sliding
   across it like an overlay. */
const N = COARSE ? 40 : 78;
const pos = new Float32Array(N * 3), home = new Float32Array(N * 3);
const phase = new Float32Array(N), spd = new Float32Array(N);
for (let i = 0; i < N; i++) {
  const x = (Math.random() - 0.5) * 42;
  const y = 0.12 + Math.pow(Math.random(), 2.1) * 3.4;   /* strongly low */
  const z = 6 + Math.random() * 16;                       /* between shop and type */
  home[i*3] = pos[i*3] = x; home[i*3+1] = pos[i*3+1] = y; home[i*3+2] = pos[i*3+2] = z;
  phase[i] = Math.random() * Math.PI * 2;
  spd[i] = 0.45 + Math.random() * 0.95;
}
const flyGeo = new THREE.BufferGeometry();
flyGeo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
flyGeo.setAttribute('aPhase', new THREE.BufferAttribute(phase, 1));
const flyMat = new THREE.ShaderMaterial({
  uniforms: { uTime: { value: 0 }, uPx: { value: 190 } },
  transparent: true, depthWrite: false, blending: THREE.AdditiveBlending,
  vertexShader:
    'attribute float aPhase; uniform float uTime, uPx; varying float vG;\n' +
    'void main(){ vec4 mv = modelViewMatrix * vec4(position,1.0);\n' +
    ' float b = 0.30 + 0.70 * pow(0.5 + 0.5*sin(uTime*1.6 + aPhase*3.3), 2.6);\n' +
    ' vG = b;\n' +
    ' gl_PointSize = (0.5 + 1.25*b) * (uPx / -mv.z);\n' +
    ' gl_Position = projectionMatrix * mv; }',
  fragmentShader:
    'varying float vG;\n' +
    'void main(){ vec2 d = gl_PointCoord - 0.5; float r = length(d);\n' +
    ' if (r > 0.5) discard;\n' +
    ' float core = smoothstep(0.16,0.0,r), halo = smoothstep(0.5,0.0,r);\n' +
    ' vec3 c = mix(vec3(1.6,1.05,0.42), vec3(2.2,1.9,1.2), core);\n' +
    ' gl_FragColor = vec4(c, (core*0.9 + halo*0.18) * vG); }'
});
scene.add(new THREE.Points(flyGeo, flyMat));

/* ------------------------------------------------------ post-processing
   Kage's chain: bright pass, four blur levels, then a composite that tone
   maps, adds the bloom back, and finishes with vignette, grain and a touch of
   chromatic aberration. */
const QUAD_VS = 'varying vec2 vUv;void main(){vUv=uv;gl_Position=vec4(position.xy,0.,1.);}';
const P = { levels: [] };
P.cam = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
P.quad = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), null);
P.quad.frustumCulled = false;
P.qs = new THREE.Scene(); P.qs.add(P.quad);
const RT = { minFilter: THREE.LinearFilter, magFilter: THREE.LinearFilter,
             type: THREE.HalfFloatType, depthBuffer: false, stencilBuffer: false };

P.bright = new THREE.ShaderMaterial({
  uniforms: { tS: { value: null }, uThr: { value: 0.62 }, uKnee: { value: 0.45 } },
  vertexShader: QUAD_VS,
  fragmentShader:
    'uniform sampler2D tS; uniform float uThr,uKnee; varying vec2 vUv;\n' +
    'void main(){ vec3 c = texture2D(tS,vUv).rgb;\n' +
    ' float l = dot(c, vec3(0.2126,0.7152,0.0722));\n' +
    ' gl_FragColor = vec4(c * smoothstep(uThr, uThr+uKnee, l), 1.0); }'
});
P.blur = new THREE.ShaderMaterial({
  uniforms: { tS: { value: null }, uDir: { value: new THREE.Vector2(1, 0) } },
  vertexShader: QUAD_VS,
  fragmentShader:
    'uniform sampler2D tS; uniform vec2 uDir; varying vec2 vUv;\n' +
    'void main(){ vec3 c = texture2D(tS,vUv).rgb*0.2270270270;\n' +
    ' c += texture2D(tS,vUv+uDir*1.3846153846).rgb*0.3162162162;\n' +
    ' c += texture2D(tS,vUv-uDir*1.3846153846).rgb*0.3162162162;\n' +
    ' c += texture2D(tS,vUv+uDir*3.2307692308).rgb*0.0702702703;\n' +
    ' c += texture2D(tS,vUv-uDir*3.2307692308).rgb*0.0702702703;\n' +
    ' gl_FragColor = vec4(c,1.0); }'
});
P.up = new THREE.ShaderMaterial({
  uniforms: { tS: { value: null }, uAmt: { value: 1 } }, vertexShader: QUAD_VS,
  fragmentShader: 'uniform sampler2D tS; uniform float uAmt; varying vec2 vUv;\n' +
    'void main(){ gl_FragColor = vec4(texture2D(tS,vUv).rgb*uAmt,1.0); }',
  blending: THREE.AdditiveBlending, transparent: true, depthTest: false, depthWrite: false
});
P.comp = new THREE.ShaderMaterial({
  uniforms: { tS: { value: null }, tB: { value: null }, uRes: { value: new THREE.Vector2(1, 1) },
              uT: { value: 0 }, uBloom: { value: 0.62 } },
  vertexShader: QUAD_VS,
  fragmentShader:
    'uniform sampler2D tS,tB; uniform vec2 uRes; uniform float uT,uBloom; varying vec2 vUv;\n' +
    'vec3 aces(vec3 x){ return clamp((x*(2.51*x+0.03))/(x*(2.43*x+0.59)+0.14),0.0,1.0); }\n' +
    'void main(){ vec2 d = vUv-0.5; float r2 = dot(d,d);\n' +
    ' float ca = (0.30 + r2*2.6)*0.0016;\n' +
    ' vec3 c; c.r = texture2D(tS,vUv+d*ca).r; c.g = texture2D(tS,vUv).g; c.b = texture2D(tS,vUv-d*ca).b;\n' +
    ' c += texture2D(tB,vUv).rgb * uBloom;\n' +
    ' c = aces(c);\n' +
    ' float l = dot(c, vec3(0.2126,0.7152,0.0722));\n' +
    ' c = mix(c, c*vec3(0.80,0.94,1.16), smoothstep(0.45,0.0,l)*0.85);\n' +
    ' c = mix(c, c*vec3(1.06,0.99,0.94), smoothstep(0.45,1.0,l)*0.40);\n' +
    ' float v = smoothstep(1.25,0.22,length(d*vec2(1.0,0.95))*1.45);\n' +
    ' c *= v;\n' +
    ' float g = fract(sin(dot(vUv*uRes + uT*137.0, vec2(12.9898,78.233)))*43758.5453);\n' +
    ' c += (g-0.5)*0.028;\n' +
    ' vec3 e = pow(max(c,0.0), vec3(1.0/2.2));\n' +
    ' e = clamp((e-0.28)*1.06 + 0.28, 0.0, 1.0);\n' +
    ' gl_FragColor = vec4(e,1.0); }'
});

function buildTargets(w, h) {
  if (P.scene) { P.scene.dispose(); P.levels.forEach(L => { L.a.dispose(); L.b.dispose(); }); }
  P.levels = [];
  P.scene = new THREE.WebGLRenderTarget(w, h, Object.assign({}, RT, { depthBuffer: true }));
  let lw = Math.max(2, w >> 1), lh = Math.max(2, h >> 1);
  for (let i = 0; i < 4; i++) {
    P.levels.push({ a: new THREE.WebGLRenderTarget(lw, lh, RT), b: new THREE.WebGLRenderTarget(lw, lh, RT), w: lw, h: lh });
    lw = Math.max(2, lw >> 1); lh = Math.max(2, lh >> 1);
  }
  P.comp.uniforms.uRes.value.set(w, h);
}
function pass(mat, target, additive) {
  P.quad.material = mat;
  renderer.setRenderTarget(target || null);
  if (!additive) renderer.clear(true, false, false);
  renderer.render(P.qs, P.cam);
}
function renderPost() {
  const L = P.levels;
  if (!L.length) return;
  renderer.setRenderTarget(P.scene);
  renderer.clear(true, true, false);
  renderer.render(scene, camera);

  P.bright.uniforms.tS.value = P.scene.texture;
  pass(P.bright, L[0].a);
  for (let i = 0; i < L.length; i++) {
    if (i > 0) { P.up.blending = THREE.NoBlending; P.up.uniforms.uAmt.value = 1; P.up.uniforms.tS.value = L[i-1].a; pass(P.up, L[i].a); }
    P.blur.uniforms.tS.value = L[i].a; P.blur.uniforms.uDir.value.set(1/L[i].w, 0); pass(P.blur, L[i].b);
    P.blur.uniforms.tS.value = L[i].b; P.blur.uniforms.uDir.value.set(0, 1/L[i].h); pass(P.blur, L[i].a);
  }
  P.up.blending = THREE.AdditiveBlending; P.up.uniforms.uAmt.value = 0.55;
  for (let i = L.length - 1; i > 0; i--) { P.up.uniforms.tS.value = L[i].a; pass(P.up, L[i-1].a, true); }
  P.comp.uniforms.tS.value = P.scene.texture;
  P.comp.uniforms.tB.value = L[0].a;
  renderer.setRenderTarget(null);
  pass(P.comp, null);
}

/* --------------------------------------------------------------- pointer */
const ptr = { x: 0, y: 0, tx: 0, ty: 0, has: false };
const cursor = new THREE.Vector3(0, 0, 12);
const ray = new THREE.Raycaster();
const gp = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);
const ndc = new THREE.Vector2();
if (!COARSE) {
  host.addEventListener('pointermove', e => {
    const r = host.getBoundingClientRect();
    ptr.tx = ((e.clientX - r.left) / r.width) * 2 - 1;
    ptr.ty = ((e.clientY - r.top) / r.height) * 2 - 1;
    ptr.has = true;
    ndc.set(ptr.tx, -ptr.ty);
    ray.setFromCamera(ndc, camera);
    ray.ray.intersectPlane(gp, cursor);
  }, { passive: true });
  host.addEventListener('pointerleave', () => { ptr.tx = 0; ptr.ty = 0; ptr.has = false; }, { passive: true });
}

/* ------------------------------------------------------------------ loop */
const lerp = (a, b, t) => a + (b - a) * t;
const damp = (c, t, r, dt) => lerp(c, t, 1 - Math.exp(-r * dt));

/* Called at start-up as well as every frame: the loop pauses whenever the
   hero is off screen, and without an initial placement the camera would still
   be at the origin the first time anything drew. */
function placeCamera() {
  /* 0.26rad moved the camera seven metres sideways; the wordmark sits only
     six from the lens, so it swung clean out of frame while the building
     barely turned. Small arc, big parallax — the near object does the work. */
  const az = ptr.x * 0.105, el = -ptr.y * 0.055;
  const r = CAM_BASE.z - LOOK.z;
  camera.position.set(LOOK.x + Math.sin(az) * r, CAM_BASE.y + el * 6, LOOK.z + Math.cos(az) * r);
  camera.lookAt(LOOK);
  /* The wordmark sits six metres from the lens and the building thirty. Left
     free, a small camera move slides the near object right out of frame while
     the far one barely turns. So the type travels with most of the camera's
     lateral shift and keeps its place in the composition; the building, which
     moves not at all, still slides behind it. The parallax is the difference
     between them, and that difference is what reads as depth. */
  big.position.x = camera.position.x * 0.84;
  small.position.x = camera.position.x * 0.84;
  big.rotation.y = az * 0.55;
  small.rotation.y = az * 0.55;
}

function resize() {
  const w = host.clientWidth, h = host.clientHeight;
  if (!w || !h) return;
  const dpr = Math.min(devicePixelRatio || 1, 1.7);
  renderer.setPixelRatio(dpr);
  renderer.setSize(w, h, false);
  camera.aspect = w / h;
  camera.fov = 38 / Math.max(0.7, Math.min(1, (w / h) / 1.5));
  camera.updateProjectionMatrix();
  buildTargets(Math.floor(w * dpr), Math.floor(h * dpr));
}

let last = 0, running = true, clock = 0;
function frame(now) {
  requestAnimationFrame(frame);
  if (!running) return;
  const dt = Math.min(0.05, (now - last) / 1000 || 0.016);
  last = now; clock += dt;

  ptr.x = damp(ptr.x, ptr.tx, 3.0, dt);
  ptr.y = damp(ptr.y, ptr.ty, 3.0, dt);
  placeCamera();

  const p = flyGeo.attributes.position.array;
  for (let i = 0; i < N; i++) {
    const j = i * 3, s = spd[i], ph = phase[i];
    let x = home[j]     + Math.sin(clock * 0.30 * s + ph) * 1.35;
    let y = home[j + 1] + Math.sin(clock * 0.55 * s + ph * 1.7) * 0.40;
    let z = home[j + 2] + Math.cos(clock * 0.25 * s + ph * 0.8) * 1.15;
    if (ptr.has) {
      const dx = x - cursor.x, dz = z - cursor.z;
      const d2 = dx * dx + dz * dz, R = 5.4;
      if (d2 < R * R) {
        const d = Math.max(0.4, Math.sqrt(d2));
        const k = 1 - d / R;
        /* push out and swirl, so it reads as a disturbance in the air rather
           than a hard exclusion circle */
        x += (dx / d) * k * 4.0 - (dz / d) * k * 1.6;
        z += (dz / d) * k * 4.0 + (dx / d) * k * 1.6;
        y += k * 0.55;
      }
    }
    p[j] = x; p[j + 1] = y; p[j + 2] = z;
  }
  flyGeo.attributes.position.needsUpdate = true;
  flyMat.uniforms.uTime.value = clock;
  P.comp.uniforms.uT.value = clock;

  renderPost();
}

if ('IntersectionObserver' in window) {
  new IntersectionObserver(es => { running = es[0].isIntersecting; }, { threshold: 0.02 }).observe(host);
}
document.addEventListener('visibilitychange', () => { if (document.hidden) running = false; });
addEventListener('resize', resize, { passive: true });

resize();
placeCamera();
host.classList.add('is-live');
requestAnimationFrame(frame);

window.__hero3d = { scene, camera, renderer, big, small, renderPost, P, ptr, placeCamera };
})();
